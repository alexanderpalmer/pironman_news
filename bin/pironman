#!/bin/bash
# /usr/local/bin/pironman

####
#### Usage:
####   pironman <OPTION> <input>
####
#### Options:
####   start                start pironman service
####
####   stop                 stop pironman service
####
####   restart              restart pironman service
####
####   status               show service status
####
####   log                  follow the service log
####
####   -h,--help            help, show this help
####
####   -c,--check           show all configurations
####
####   -a,--auto            [ on ],enable auto-start at boot
####                        [ off ], disable auto-start at boot
####
####   -u,--unit            [ C/F ], set the unit of temperature shown on the
####                        screen, C or F (Celsius/Fahrenheit).
####                        The fan threshold stays in celsius.
####
####   -f,--fan             [ temp ], Temperature at which the fan switches on,
####                        in celsius (default 50), in range (30 ~ 80)
####
####   -al,--always_on      [on/true/off/false], whether the screen is always on,
####                        default False
####
####   -s,--staty_time      [time], screen display duration in second,
####                        in second, default 60
####
####   -re|--rgb_enable)    [on/true/off/false], whether enable rgb strip,
####
####   -rs,--rgb_style      rgb strip display style, default: breath,
####                        in [breath / static / leap / flow / raise_up / colorful
####                         / colorful_static / colorful_leap]
####
####   -rc,--rgb_color      [(HEX)color], set the color of rgb strip,
####                        default: 0a1aff
####
####   -rb,--rgb_speed      [speed], rgb blink speed (0 ~ 100, default 50)
####
####   -pwm,--rgb_pwm       [frequency], rgb signal frequency (400 ~ 1600, default 1000 kHz)
####                        only used by the ws281x backend
####
####   -rp,--rgb_pin        [pin], rgb signal pin, could be [10 / spi/ SPI / 12 / pwm/ PWM] or
####                        [21 / pcm / PCM], default 10
####
####   -bk,--rgb_backend    [auto/spi/ws281x], how the WS2812 signal is generated.
####                        "spi" uses the kernel SPI driver on GPIO10 and needs
####                        no extra library, "ws281x" needs the rpi-ws281x pip
####                        package and is required for pin 12 and 21.
####                        default auto
####
####   -F,--foreground      run in foreground
####

CONF=/opt/pironman/config.txt
main='/opt/pironman/main.py'
LOG=/opt/pironman/log
SERVICE=pironman.service

# print colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
GRAY='\033[1;30m'
#
NC='\033[0m'

# check boot configuration path
DEFAULT_BOOT_CONFIG="/boot/firmware/config.txt"
BACKUP_BOOT_CONFIG="/boot/config.txt"
boot_config=""

run_in_background=true
# set when an option changed the configuration, so the service is only
# restarted when there is something new to pick up
config_changed=false

# Check if user is root
if [ $(id -u) -ne 0 ]; then
  echo -e "Script must be run as root. Try 'sudo pironman $@'\n"
  exit 1
fi


# check boot configuration path
if [ -f "$DEFAULT_BOOT_CONFIG" ]; then
    boot_config=${DEFAULT_BOOT_CONFIG}
elif [ -f $BACKUP_BOOT_CONFIG ]; then
    boot_config=${BACKUP_BOOT_CONFIG}
else
    boot_config=""
    echo -e "${RED}Warning: Cannot find boot configuration file${NC}"
fi

##################### ---- fuctions ---- #####################

help() {
  echo -e "\nconfig file:${CONF}"
  sed -rn 's/^#### //; s/^####$//; T; p;' "$0"
}

# True when systemd is running and knows our unit, which is the normal
# case after "sudo python3 install.py".
have_service() {
  [ -d /run/systemd/system ] || return 1
  systemctl list-unit-files "${SERVICE}" >/dev/null 2>&1
}

start() {
  if [ "$run_in_background" == false ]; then
    echo "run in foreground"
    exec python3 "$main"
  fi
  if have_service; then
    systemctl start "${SERVICE}"
  else
    echo "run in background"
    nohup python3 "$main" >/dev/null 2>>"$LOG" &
  fi
  if [ $? == '0' ]; then
    echo "pironman start succeed"
  else
    echo "pironman start failed"
  fi
}

stop() {
  echo "stopping pironman"
  if have_service; then
    # main.py cleans up on SIGTERM: screen off, fan off, LEDs cleared
    systemctl stop "${SERVICE}"
  else
    # match the script path exactly instead of the old
    # "ps aux | grep $main | awk '{print $2}'", which also picked up the
    # grep itself and any unrelated process whose command line contained
    # the path, and then passed that whole list to kill
    pkill -TERM -f "python3 ${main}" 2>/dev/null
    for _ in $(seq 1 30); do
      pgrep -f "python3 ${main}" >/dev/null 2>&1 || break
      sleep 0.1
    done
    # make sure the strip is dark even if the process was already gone
    python3 "$main" close_rgb >/dev/null 2>>"$LOG"
  fi
}

restart() {
  echo "restarting pironman"
  if have_service && [ "$run_in_background" == true ]; then
    systemctl restart "${SERVICE}"
  else
    stop
    start
  fi
}

want_reboot() {
  read -e -p "$(echo -e ${GREEN}Do you want to reboot to make the changes take effect? \(Y/N\): ${NC})" choice
  if [ "$choice" == "Y" ] || [ "$choice" == "y" ]; then
    echo "Rebooting now ..."
    reboot
  fi
}

# set "key = value" in an ini style config file, appending it under [all]
# when the key is not there yet
set_conf() {
  # $1: key, $2: value, $3: file
  if grep -qE "^[[:space:]]*#?[[:space:]]*$1[[:space:]]*=" "$3"; then
    sed -i -E "s|^[[:space:]]*#?[[:space:]]*$1[[:space:]]*=.*|$1 = $2|" "$3"
  else
    grep -q '^\[all\]' "$3" || echo '[all]' >>"$3"
    echo "$1 = $2" >>"$3"
  fi
  config_changed=true
}

change_config() {
  # $1: check string
  # $2: replace string
  # $3: config file path
  if grep -q -e "$1" "$3"; then
    sed -i -e "s:$1:$2:g" "$3"
  else
    sed -i -e "$ a[all]\n$2" "$3"
  fi
}

##################### ---- main ---- #####################

if [ $# -eq 0 ]; then
  help
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    start)
      shift
      # remaining options may still turn up (e.g. -F), handle at the end
      if [[ $# -eq 0 ]]; then
        start
        exit 0
      fi
      ;;
    stop)
      stop
      exit 0
      ;;
    restart)
      restart
      exit 0
      ;;
    status)
      if have_service; then
        systemctl status "${SERVICE}" --no-pager
      else
        pgrep -af "python3 ${main}" || echo "pironman is not running"
      fi
      exit 0
      ;;
    log)
      if have_service; then
        journalctl -u "${SERVICE}" -f -n 50
      else
        tail -f "$LOG"
      fi
      exit 0
      ;;
    -h|--help)
      help
      exit 0
      ;;
    -c|--check)
      echo -e "config file:${CONF}\n"
      grep -E '=.' "${CONF}"
      exit 0
      ;;
    -a|--auto)
      case "$2" in
        "on"|true)
          echo "enable auto-start at boot"
          systemctl enable "${SERVICE}"
          shift 2
          ;;
        "off"|false)
          echo "disable auto-start at boot"
          systemctl disable "${SERVICE}"
          shift 2
        ;;
        *)
          echo "usage: pironman -a|--auto [on/off]"
          exit 1
          ;;
      esac
      ;;
    -u|--unit)
      if [ $# -lt 2 ] ;then
        echo "usage: pironman -u|--unit [C/F]"
        exit 1
      else
        if [ "$2" == 'C' ] || [ "$2" == 'F' ];then
          set_conf temp_unit "$2" "${CONF}"
          echo "set temperature unit to $2"
          shift 2
        else
          echo "unit must be C or F"
          exit 1
        fi
      fi
      ;;
    -f|--fan)
      if [ $# -lt 2 ]; then
        echo "usage: pironman -f|--fan [temp]"
        exit 1
      else
        if [[ $2 =~ ^[[:digit:]]+$ ]]; then
          if [ "$2" -ge 30 ] && [ "$2" -le 80 ]; then
            echo "set the fan on temperature to $2 "
            set_conf fan_temp "$2" "${CONF}"
            shift 2
          else
            echo "out of range (30 ~ 80) "
            exit 1
          fi
        else
          echo "parameter must be integer"
          exit 1
        fi
      fi
      ;;
    -al|--always_on)
      case "$2" in
        "on"|true)
          echo "set screen_always_on to on "
          set_conf screen_always_on True "${CONF}"
          shift 2
        ;;
        "off"|false)
          echo "set screen_always_on to off "
          set_conf screen_always_on False "${CONF}"
          shift 2
        ;;
        *)
          echo "usage: pironman -al|--always_on [on|off]"
          exit 1
      esac
      ;;
    -s|--staty_time)
      if [ $# -lt 2 ]; then
        echo "usage: pironman -s|--staty_time [time], in seconds"
        exit 1
      else
        if [[ $2 =~ ^[[:digit:]]+$ ]]; then
          echo "set screen_off_time to $2 "
          set_conf screen_off_time "$2" "${CONF}"
          shift 2
        else
          echo "parameter must be integer"
          exit 1
        fi
      fi
      ;;
    -re|--rgb_enable)
      case "$2" in
        "on"|true)
          echo "set rgb_enable to on "
          set_conf rgb_enable True "${CONF}"
          shift 2
        ;;
        "off"|false)
          echo "set rgb_enable to off "
          set_conf rgb_enable False "${CONF}"
          shift 2
        ;;
        *)
          echo "usage: pironman -re|--rgb_enable [on|true|off|false]"
          exit 1
        ;;
      esac
      ;;
    -rs|--rgb_style)
      case "$2" in
        breath|static|leap|flow|raise_up|colorful|colorful_static|colorful_leap)
          echo "set rgb_style to $2 "
          set_conf rgb_style "$2" "${CONF}"
          shift 2
        ;;
        *)
          echo "usage: pironman -rs|--rgb_style [breath / static / leap / flow / raise_up / colorful / colorful_static / colorful_leap]"
          exit 1
        ;;
      esac
      ;;
    -rc|--rgb_color)
      if [ $# -lt 2 ]; then
        echo "usage: pironman -rc|--rgb_color [color],clolor in HEX. eg: 0a1aff"
        exit 1
      else
        if [[ $2 =~ ^#?[0-9a-fA-F]{6}$ ]]; then
          echo "set rgb_color to $2 "
          set_conf rgb_color "${2#\#}" "${CONF}"
          shift 2
        else
          echo "color must be 6 hex digits, eg: 0a1aff"
          exit 1
        fi
      fi
      ;;
    -rb|--rgb_speed)
      if [ $# -lt 2 ]; then
        echo "usage: pironman -rb|--rgb_speed [speed],speed in range (0 ~ 100)"
        exit 1
      else
        if [[ $2 =~ ^[[:digit:]]+$ ]]; then
          if [ $2 -ge 0 ] && [ $2 -le 100 ]; then
            echo "set rgb_blink_speed to $2 "
            set_conf rgb_blink_speed "$2" "${CONF}"
            shift 2
          else
            echo "out of range (0 ~ 100) "
            exit 1
          fi
        else
          echo "parameter must be integer"
          exit 1
        fi
      fi
      ;;
    -pwm|--rgb_pwm)
      if [ $# -lt 2 ]; then
        echo "usage: pironman -pwm|--rgb_pwm [frequency],frequency in range (400 ~ 1600) kHz"
        exit 1
      else
        if [[ $2 =~ ^[[:digit:]]+$ ]];
        then
          if [ $2 -ge 400 ] && [ $2 -le 1600 ];
          then
            echo "set rgb_pwm_freq to $2 "
            set_conf rgb_pwm_freq "$2" "${CONF}"
            shift 2
          else
            echo "out of range (400 ~ 1600) kHz "
            exit 1
          fi
        else
          echo "parameter must be integer"
          exit 1
        fi
      fi
      ;;
    -bk|--rgb_backend)
      case "$2" in
        auto|spi|ws281x)
          echo "set rgb_backend to $2 "
          set_conf rgb_backend "$2" "${CONF}"
          shift 2
          ;;
        *)
          echo "usage: pironman -bk|--rgb_backend [auto/spi/ws281x]"
          exit 1
          ;;
      esac
      ;;
    -rp|--rgb_pin)
      case "$2" in
        spi|SPI|10)
          echo "set rgb io to pin 10 (spi)"
          # set pin
          set_conf rgb_pin 10 "${CONF}"
          #
          if [[ $boot_config != "" ]]; then
            echo "boot_config: ${boot_config}"
            ## enable audio
            change_config ".*dtparam=audio=.*" "dtparam=audio=on" ${boot_config}
            # enable spi
            change_config ".*dtparam=spi=.*"  "dtparam=spi=on" ${boot_config}
            # change core_freq, core_freq_min to stabilize the spi output frequency
            change_config ".*core_freq=.*"  "core_freq=500" ${boot_config}
            change_config ".*core_freq_min=.*"  "core_freq_min=500" ${boot_config}
            # whether reboot to make changes take effect
            want_reboot
            # restart program
          fi
          shift 2
          ;;
        pwm|PWM|12)
          echo "set rgb io to pin 12 (pwm)"
          # set io
          set_conf rgb_pin 12 "${CONF}"
          # the SPI backend can only drive GPIO10, pin 12 needs rpi_ws281x
          set_conf rgb_backend ws281x "${CONF}"
          if ! python3 -c "import rpi_ws281x" 2>/dev/null; then
            echo -e "${YELLOW}Warning: the rpi-ws281x package is missing, pin 12 will not work."
            echo -e "Install it with: sudo python3 install.py --with-ws281x${NC}"
          fi
          #
          if [[ $boot_config != "" ]]; then
            echo "boot_config: ${boot_config}"
            # disable audio
            change_config ".*dtparam=audio=.*" "dtparam=audio=off" ${boot_config}
            # whether reboot to make changes take effect
            want_reboot
          fi
          # restart program
          shift 2
          ;;
        pcm|PCM|21)
          echo "set rgb io to pin 21 (pcm)"
          # set io
          set_conf rgb_pin 21 "${CONF}"
          # the SPI backend can only drive GPIO10, pin 21 needs rpi_ws281x
          set_conf rgb_backend ws281x "${CONF}"
          if ! python3 -c "import rpi_ws281x" 2>/dev/null; then
            echo -e "${YELLOW}Warning: the rpi-ws281x package is missing, pin 21 will not work."
            echo -e "Install it with: sudo python3 install.py --with-ws281x${NC}"
          fi
          #
          if [[ $boot_config != "" ]]; then
            echo "boot_config: ${boot_config}"
              ## enable audio
            change_config ".*dtparam=audio=.*" "dtparam=audio=on" ${boot_config}
            # disable i2s
            change_config ".*dtoverlay=hifiberry-dac$" "#dtoverlay=hifiberry-dac" ${boot_config}
            change_config ".*dtoverlay=i2s-mmap$" "#dtoverlay=i2s-mmap" ${boot_config}
            # whether reboot to make changes take effect
            want_reboot
          fi
          # restart program
          shift 2
          ;;
        *)
          echo "usage: pironman -rp|--rgb_pin [10 / spi / 12 / pwm / 21 / pcm]"
          exit 1
          ;;
      esac
      ;;
    -F|--foreground)
      run_in_background="false"
      shift
      ;;
    *)
      echo -e "${RED}Invalid argument: $1.${NC}"
      exit 1
      ;;
  esac
done

if [ "$run_in_background" == false ]; then
  start
else
  restart
fi
